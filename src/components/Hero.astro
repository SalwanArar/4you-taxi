---
// Hero text and call actions, slotted into CarViewer: the text sits above the car, the actions below.
import Icon from './Icon.astro';
import { business, content, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
---

<div class="hero-top wrap">
  <h1 id="hero-title" class="hero-title">
    {t.hero.title}
  </h1>
  <p class="mt-3 text-muted" style="font-size: var(--fs-lead)">
    {t.hero.subtitle}
  </p>
</div>

<div class="hero-foot wrap">
  <div class="flex flex-wrap gap-3">
    <a href={`tel:${business.phone.e164}`} class="btn btn-call text-lg">
      <Icon name="phone" />
      {t.actions.call}
    </a>
    <a
      href={`https://wa.me/${business.whatsapp}`}
      class="btn btn-ghost text-lg"
      rel="noopener"
      target="_blank"
    >
      <Icon name="whatsapp" />
      {t.actions.whatsapp}
    </a>
  </div>
  <a href={`tel:${business.phone.e164}`} class="hero-number" dir="ltr">
    {business.phone.display}
  </a>
</div>

<style>
  .hero-top {
    position: relative;
    grid-row: 1;
    padding-top: calc(var(--header-h) + clamp(1.25rem, 5vh, 3.5rem));
  }

  .hero-title {
    font-size: var(--fs-display);
    letter-spacing: -0.035em;
    line-height: 1;
    max-width: 14ch;
  }

  :global(:lang(ar)) .hero-title {
    letter-spacing: 0;
    line-height: 1.25;
  }

  .hero-foot {
    position: relative;
    grid-row: 3;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding-block: 2.75rem 1.5rem;
  }

  .hero-number {
    font-size: var(--fs-lead);
    color: var(--text-muted);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  .hero-number:hover {
    color: var(--text);
  }
</style>
