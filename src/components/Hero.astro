---
import Icon from './Icon.astro';
import { business, content, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
---

<section id="top" class="bg-brand-black text-white" aria-labelledby="hero-title">
  <div class="mx-auto max-w-content px-4 py-20 sm:py-28">
    <p class="font-semibold text-brand-yellow">{business.name}</p>
    <h1 id="hero-title" class="mt-3 max-w-2xl text-4xl sm:text-6xl">
      {t.hero.title}
    </h1>
    <p class="mt-5 max-w-xl text-lg text-white/80">{t.hero.subtitle}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={`tel:${business.phone.e164}`} class="btn btn-primary text-lg">
        <Icon name="phone" />
        {t.actions.call}
      </a>
      <a
        href={`https://wa.me/${business.whatsapp}`}
        class="btn btn-on-dark text-lg"
        rel="noopener"
        target="_blank"
      >
        <Icon name="whatsapp" />
        {t.actions.whatsapp}
      </a>
    </div>
    <p class="mt-5 text-white/80">
      <span dir="ltr">{business.phone.display}</span>
    </p>
  </div>
</section>
