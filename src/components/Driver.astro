---
import { business, content, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
---

<section class="section" aria-labelledby="driver-title">
  <div class="section-grid">
    <h2 id="driver-title" class="section-heading">
      {t.driver.heading}
    </h2>
    <ul class="rows">
      <li class="rows-lead">{business.driverName}</li>
      <li>
        {t.driver.languagesLabel}: {t.driver.languagesSpoken}
      </li>
      {t.driver.bio && <li>{t.driver.bio}</li>}
    </ul>
  </div>
</section>
