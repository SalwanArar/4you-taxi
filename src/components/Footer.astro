---
import { business, content, type Locale } from '../data/site';
import { withBase } from '../utils/withBase';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
const year = new Date().getFullYear();
---

<footer class="on-dark bg-brand-black text-white/70">
  <div class="mx-auto max-w-content px-4 py-10 text-sm">
    <img src={withBase('/logo.webp')} alt={business.name} width="108" height="64" loading="lazy" />
    <p class="mt-3">{t.serviceArea}</p>
    <p class="mt-4">
      © {year} {business.name}. {t.footer.rights}
    </p>
  </div>
</footer>
