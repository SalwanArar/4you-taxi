---
import { business, content, designer, type Locale } from '../data/site';
import { withBase } from '../utils/withBase';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
const year = new Date().getFullYear();
---

<footer class="text-muted">
  {/* The road band from the business card: taxi yellow with a dashed black lane line. */}
  <div class="road-band" aria-hidden="true"></div>
  <div
    class="wrap flex flex-wrap items-center justify-between gap-4 py-8"
    style="font-size: var(--fs-small)"
  >
    <img src={withBase('/logo.svg')} alt={business.name} width="148" height="32" loading="lazy" />
    <div class="flex flex-wrap items-center gap-x-6">
      <p>
        © {year} {business.name}. {t.footer.rights}
      </p>
      <p>
        {t.footer.designedBy}{' '}
        <a
          href={designer.url}
          class="inline-flex min-h-tap items-center text-text underline decoration-line underline-offset-4 hover:decoration-taxi"
          rel="author noopener"
          target="_blank"
        >
          {designer.name}
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .road-band {
    height: 1.5rem;
    background:
      repeating-linear-gradient(
          90deg,
          var(--night) 0 var(--road-dash),
          transparent var(--road-dash) calc(var(--road-dash) + var(--road-gap))
        )
        center / 100% 4px no-repeat,
      var(--taxi);
  }
</style>
