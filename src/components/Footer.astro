---
import { business, company, content, designer, type Locale } from '../data/site';
import { withBase } from '../utils/withBase';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
const year = new Date().getFullYear();
// The registered company behind the service; a value left '' in site.ts is not shown.
const legal = [
  company.legalName,
  company.orgNumber && `${t.footer.orgNumber} ${company.orgNumber}`,
  company.licence && `${t.footer.licence} ${company.licence}`,
].filter(Boolean);
---

<footer class="border-t border-line text-muted">
  <div
    class="wrap flex flex-wrap items-center justify-between gap-4 py-8"
    style="font-size: var(--fs-small)"
  >
    <img src={withBase('/logo.svg')} alt={business.name} width="148" height="32" loading="lazy" />
    <div class="flex flex-wrap items-center gap-x-6">
      <p>
        © {year} {business.name}. {t.footer.rights}
      </p>
      <p>
        {t.footer.designedBy}{' '}
        <a
          href={designer.url}
          class="inline-flex min-h-tap items-center text-text underline decoration-line underline-offset-4 hover:decoration-taxi"
          rel="author noopener"
          target="_blank"
        >
          {designer.name}
        </a>
      </p>
    </div>
    {legal.length > 0 && (
      <p class="w-full">
        {legal.map((item, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <span class="whitespace-nowrap">{item}</span>
          </>
        ))}
      </p>
    )}
  </div>
</footer>
