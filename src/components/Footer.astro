---
import { business, content, designer, type Locale } from '../data/site';
import { withBase } from '../utils/withBase';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
const year = new Date().getFullYear();
---

<footer class="border-t border-line text-muted">
  <div
    class="wrap flex flex-wrap items-center justify-between gap-4 py-8"
    style="font-size: var(--fs-small)"
  >
    <img src={withBase('/logo.webp')} alt={business.name} width="68" height="40" loading="lazy" />
    <div class="flex flex-wrap items-center gap-x-6">
      <p>
        © {year} {business.name}. {t.footer.rights}
      </p>
      <p>
        {t.footer.designedBy}{' '}
        <a
          href={designer.url}
          class="inline-flex min-h-tap items-center text-text underline decoration-line underline-offset-4 hover:decoration-taxi"
          rel="author noopener"
          target="_blank"
        >
          {designer.name}
        </a>
      </p>
    </div>
  </div>
</footer>
