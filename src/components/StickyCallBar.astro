---
// Phones only: fixed Call/WhatsApp bar, always on screen, so calling is one tap from anywhere.
import Icon from './Icon.astro';
import { business, content, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
---

<div
  id="quick-contact"
  role="region"
  aria-label={t.quickContactLabel}
  class="quick-contact fixed inset-x-0 bottom-0 z-40 border-t border-line bg-night/90 px-4 pt-3 backdrop-blur-md sm:hidden"
>
  <div class="grid grid-cols-2 gap-3">
    <a href={`tel:${business.phone.e164}`} class="btn btn-call">
      <Icon name="phone" />
      {t.actions.callShort}
    </a>
    <a
      href={`https://wa.me/${business.whatsapp}`}
      class="btn btn-ghost bg-asphalt"
      target="_blank"
      rel="noopener"
    >
      <Icon name="whatsapp" />
      {t.actions.whatsapp}
    </a>
  </div>
</div>

<style>
  .quick-contact {
    padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
  }

  /* Keep the end of the page clear of the bar. */
  @media (max-width: 639px) {
    :global(body) {
      padding-bottom: var(--call-bar-h);
    }
  }
</style>
