---
// Phones only: fixed Call/WhatsApp bar that appears once the hero has scrolled out of view.
import Icon from './Icon.astro';
import { business, content, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
---

<div
  id="quick-contact"
  role="region"
  aria-label={t.quickContactLabel}
  data-hidden="true"
  class="quick-contact fixed inset-x-0 bottom-0 z-40 border-t border-line bg-night/90 px-4 pt-3 backdrop-blur-md sm:hidden"
>
  <div class="grid grid-cols-2 gap-3">
    <a href={`tel:${business.phone.e164}`} class="btn btn-call">
      <Icon name="phone" />
      {t.actions.callShort}
    </a>
    <a
      href={`https://wa.me/${business.whatsapp}`}
      class="btn btn-ghost bg-asphalt"
      target="_blank"
      rel="noopener"
    >
      <Icon name="whatsapp" />
      {t.actions.whatsapp}
    </a>
  </div>
</div>

<noscript>
  <!-- Without JS the bar is simply always shown on phones. -->
  <style is:inline>
    #quick-contact[data-hidden='true'] {
      transform: none;
      visibility: visible;
    }
  </style>
</noscript>

<style>
  .quick-contact {
    padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
    transition:
      transform 300ms ease,
      visibility 300ms;
  }

  .quick-contact[data-hidden='true'] {
    transform: translateY(100%);
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .quick-contact {
      transition: none;
    }
  }
</style>

<script>
  const bar = document.getElementById('quick-contact');
  const hero = document.getElementById('top');
  if (bar && hero) {
    new IntersectionObserver(([entry]) => {
      bar.dataset.hidden = String(entry.isIntersecting);
    }).observe(hero);
  }
</script>
