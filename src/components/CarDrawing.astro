---
// The taxi, drawn as one inline SVG from a side photo of the real car (white Škoda Octavia Combi):
// roof rails, roof sign, tow bar and the Länstaxi logo on the front door; no plate. It faces left.
// The wheels' spokes, the headlight beam and the brake light are styled by CarViewer, which turns
// and lights them with the scroll. Without CSS variables (no JS, reduced motion) it stands still.
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<svg class="car-drawing" viewBox="-40 505 1130 445" role="img" aria-label={label}>
  <defs>
    <linearGradient id="car-body" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fdfcf8" />
      <stop offset="0.5" stop-color="#f2f0ea" />
      <stop offset="0.85" stop-color="#dcd9d1" />
      <stop offset="1" stop-color="#c4c1b8" />
    </linearGradient>
    <linearGradient id="car-glass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2d3238" />
      <stop offset="1" stop-color="#101215" />
    </linearGradient>
    <linearGradient id="car-rim" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#eeede8" />
      <stop offset="1" stop-color="#a9a8a2" />
    </linearGradient>
    <linearGradient id="car-tail" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#7a1414" />
      <stop offset="1" stop-color="#c62a22" />
    </linearGradient>
    <linearGradient id="car-beam" x1="1" y1="0" x2="0" y2="0">
      <stop offset="0" stop-color="#fff3c8" stop-opacity="0.26" />
      <stop offset="1" stop-color="#fff3c8" stop-opacity="0" />
    </linearGradient>
    <radialGradient id="car-brake">
      <stop offset="0" stop-color="#ff4d3a" stop-opacity="0.45" />
      <stop offset="1" stop-color="#ff4d3a" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="car-shadow">
      <stop offset="0" stop-color="#000" stop-opacity="0.85" />
      <stop offset="1" stop-color="#000" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="car-fade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0.16" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <filter id="car-soft" x="-20%" y="-30%" width="140%" height="160%">
      <feGaussianBlur stdDeviation="9" />
    </filter>
    <mask
      id="car-reflection-mask"
      maskUnits="userSpaceOnUse"
      x="-40"
      y="873"
      width="1130"
      height="80"
    >
      <rect x="-40" y="873" width="1130" height="80" fill="url(#car-fade)" />
    </mask>
  </defs>

  <!-- Headlight beam on the road ahead -->
  <path
    class="car-beam"
    d="M80 702 L-40 664 L-40 870 Z"
    fill="url(#car-beam)"
    filter="url(#car-soft)"
  />

  <ellipse cx="565" cy="868" rx="520" ry="20" fill="url(#car-shadow)" />

