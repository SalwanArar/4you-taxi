---
import { car, content, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
---

<section class="section" aria-labelledby="car-title">
  <div class="section-grid">
    <h2 id="car-title" class="section-heading">
      {t.car.heading}
    </h2>
    <ul class="rows">
      <li class="rows-lead">{car.model}</li>
      {t.carFeatures.map((f) => (
        <li>{f.text}</li>
      ))}
    </ul>
  </div>
</section>
