---
// The car and the company in one section: the confirmed car facts set large, then a short line
// about us with the languages spoken, beside a card that asks for a Google review.
import ReviewCard from './ReviewCard.astro';
import { car, content, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
---

<section class="section" aria-labelledby="car-title">
  <div class="wrap">
    <p class="text-muted" data-reveal>
      {car.model}
    </p>
    <h2 id="car-title" class="statement mt-3" data-reveal>
      {t.car.heading}
    </h2>
    <ul class="figures mt-12 grid grid-cols-2 gap-x-6 lg:grid-cols-4">
      {t.carFeatures.map((f, i) => (
        <li class="border-t border-line pt-5 pb-8" data-reveal style={`--i: ${i}`}>
          <span class="figure block font-display">{f.figure}</span>{' '}
          <span class="mt-2 block text-muted">{f.label}</span>
        </li>
      ))}
    </ul>

    <div class="mt-12 grid gap-10 border-t border-line pt-10 md:grid-cols-2 md:items-center">
      <div aria-labelledby="about-title">
        <h3 id="about-title" class="text-muted" data-reveal>
          {t.about.heading}
        </h3>
        {t.about.bio && (
          <p class="bio mt-4 font-display" data-reveal style="--i: 1">
            {t.about.bio}
          </p>
        )}
        <p class="mt-6 text-muted" data-reveal style="--i: 2">
          {t.about.languagesLabel}: {t.about.languagesSpoken}
        </p>
      </div>
      <ReviewCard locale={locale} />
    </div>
  </div>
</section>

<style>
  .figure {
    font-size: var(--fs-figure);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }

  .bio {
    max-width: 22ch;
    font-size: var(--fs-heading);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  :global(:lang(ar)) .figure {
    letter-spacing: 0;
    line-height: 1.3;
  }

  :global(:lang(ar)) .bio {
    line-height: 1.6;
    letter-spacing: 0;
  }
</style>
