---
// Scroll-driven car rotation (CLAUDE.md §6), used as the page hero. The car stands under one
// soft light; the slotted hero content sits above and below it, and short captions with car facts
// fade in at set points while it turns. Frame 1 is a normal <img>: it is the poster (and LCP image), the no-JS
// fallback and the reduced-motion view. The script swaps in a canvas once it runs.
interface Props {
  /** Path prefix of the frames, e.g. '/car360/frame_'. */
  frames: string;
  /** Number of frames. */
  count: number;
  extension: string;
  width: number;
  height: number;
  alt: string;
  /** Accessible name of the rotating canvas. */
  label: string;
  /** id of the heading inside the slot that names this section. */
  labelledBy: string;
  hint: string;
  /** Short facts shown one after another while the car turns (from site.ts). */
  captions?: string[];
  /**
   * Story mode: the section plays as scenes. `edges` are where each scene starts (0 to 1 of the
   * scroll); the car is hidden in the first two scenes and turns between `turnStart` and
   * `turnEnd`, then holds its last frame.
   */
  story?: { edges: number[]; turnStart: number; turnEnd: number };
  id?: string;
}

const {
  frames,
  count,
  extension,
  width,
  height,
  alt,
  label,
  labelledBy,
  hint,
  captions = [],
  story,
  id,
} = Astro.props;
const poster = `${frames}001${extension}`;
---

<section
  id={id}
  class="car-viewer"
  aria-labelledby={labelledBy}
  data-car-viewer
  data-frames={frames}
  data-extension={extension}
  data-count={count}
  data-width={width}
  data-height={height}
  data-story={story ? '' : undefined}
  data-scene-edges={story?.edges.join(',')}
  data-turn-start={story?.turnStart}
  data-turn-end={story?.turnEnd}
>
  <div class="car-sticky">
    <div class="car-area">
      <div class="car-stage" style={`--car-ratio: ${width} / ${height}`}>
        <div class="car-floor" aria-hidden="true"></div>
        <img
          src={poster}
          {width}
          {height}
          {alt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="car-frame"
        />
        <canvas class="car-frame car-canvas" role="img" aria-label={label}></canvas>
        <canvas class="car-reflection" data-reflection aria-hidden="true"></canvas>
        {captions.length > 0 && (
          <ul class="car-captions" aria-hidden="true">
            {captions.map((c) => (
              <li data-caption>{c}</li>
            ))}
          </ul>
        )}
        <p class="car-hint" data-hint aria-hidden="true">
          {hint}
        </p>
      </div>
    </div>
    <slot />
  </div>
</section>

{story && <script is:inline>
  // Switch to the film before first paint, so the opening scene does not flash the end.
  (function () {
    const el = document.currentScript && document.currentScript.previousElementSibling;
    if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.dataset.scrub = 'true';
      el.dataset.scene = '0';
    }
  })();
</script>}

<style>
  /* Pure black, lit from above by one soft light. */
  /* Slides up under the translucent sticky header, so the first screen is the whole hero. */
  .car-viewer {
    position: relative;
    margin-top: calc(-1 * var(--header-h));
    background: var(--night);
  }

  /* One screen tall, laid out in three rows: hero text, the car, the call actions.
     Without JS or with reduced motion it simply stays one screen. */
  .car-sticky {
    position: sticky;
    top: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: 100vh;
    height: max(100svh, 36rem);
    overflow: hidden;
  }

  .car-sticky::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 55% at 50% 0%, var(--light-glow), transparent 70%);
    pointer-events: none;
  }

  /* Scrubbing mode, switched on by the script: tall section, the stage stays pinned. */
  .car-viewer[data-scrub] {
    height: 250vh;
  }

  @media (min-width: 640px) {
    .car-viewer[data-scrub] {
      height: 300vh;
    }
  }

  /* Story mode: a long section, so each of the first four scenes gets close to two screens of
     scroll and there is time to read every line. The last scene is short, so the page carries on
     soon after it: testers stopped scrolling there, thinking the site had ended. */
  .car-viewer[data-scrub][data-story] {
    height: 735vh;
  }

  @media (min-width: 640px) {
    .car-viewer[data-scrub][data-story] {
      height: 810vh;
    }
  }

  /* The night: the overhead light is low and the car is still in the dark. It comes up at the
     pickup (scene 2) and warms at the arrival (scene 4). */
  .car-viewer[data-scrub][data-story] .car-sticky::before {
    opacity: 0.25;
    transition: opacity 900ms ease;
  }

  .car-viewer[data-scrub][data-story]:is([data-scene='2'], [data-scene='3']) .car-sticky::before {
    opacity: 1;
  }

  .car-viewer[data-scrub][data-story] .car-sticky::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 60% at 50% 0%, rgb(255 194 14 / 0.1), transparent 70%);
    opacity: 0;
    transition: opacity 900ms ease;
    pointer-events: none;
  }

  .car-viewer[data-scrub][data-story][data-scene='4'] .car-sticky::before,
  .car-viewer[data-scrub][data-story][data-scene='4'] .car-sticky::after {
    opacity: 1;
  }

  /* The car stays in the dark during the first two scenes (drawn pictures tell those, see
     SceneArt.astro) and comes into the light at the pickup. */
  .car-viewer[data-scrub][data-story] .car-stage {
    opacity: 0;
    transform: scale(0.94);
    transition:
      opacity 1200ms ease,
      transform 1400ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .car-viewer[data-scrub][data-story]:is([data-scene='2'], [data-scene='3'], [data-scene='4'])
    .car-stage {
    opacity: 1;
    transform: none;
  }

  /* In story mode the hint sits in the middle of the dark stage, where the car will appear. */
  .car-viewer[data-story] .car-hint {
    top: 50%;
    margin-top: 0;
  }

  .car-viewer[data-scrub][data-story] .car-stage .car-hint {
    display: none;
  }

  /* The middle row: whatever height the hero text and call actions leave over. The car is sized
     from this height, so it never runs into the text above or the buttons below, in any language. */
  .car-area {
    --caption-room: 0rem; /* space kept free under the car for the facts (phones and tablets) */
    grid-row: 2;
    grid-column: 1;
    display: grid;
    align-content: center;
    min-height: 0;
    container-type: size;
  }

  .car-stage {
    position: relative;
    margin-inline: auto;
    margin-bottom: var(--caption-room);
    aspect-ratio: var(--car-ratio);
    width: min(100%, 920px, (100svh - 27rem) * var(--car-ratio));
    width: min(100%, 920px, (100cqh - var(--caption-room)) * var(--car-ratio));
  }

  .car-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .car-canvas {
    visibility: hidden;
  }

  .car-viewer[data-ready] .car-canvas {
    visibility: visible;
  }

  .car-viewer[data-ready] img.car-frame {
    visibility: hidden;
  }

  /* A faint mirror image of the car on the glossy ground, drawn and faded by the script.
     It sits half a stage lower so it has room below the wheels. */
  .car-reflection {
    position: absolute;
    inset-inline: 0;
    top: 50%;
    width: 100%;
    height: 100%;
    opacity: 0.13;
    pointer-events: none;
    visibility: hidden;
  }

  .car-viewer[data-ready] .car-reflection {
    visibility: visible;
  }

  /* The pool of light on the ground, with a soft shadow right under the car. */
  .car-floor {
    position: absolute;
    inset-inline: -12%;
    bottom: -10%;
    height: 34%;
    background:
      radial-gradient(38% 22% at 50% 50%, rgb(0 0 0 / 0.85), transparent 100%),
      radial-gradient(50% 50% at 50% 50%, var(--floor-glow), transparent 100%);
  }

  /* Car facts, one at a time, while it turns. */
  .car-captions {
    position: absolute;
    inset-inline-end: 1rem;
    bottom: 100%;
    margin: 0 0 0.5rem;
    padding: 0;
    list-style: none;
    font-size: var(--fs-lead);
  }

  .car-captions li {
    position: absolute;
    inset-inline-end: 0;
    bottom: 0;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity 300ms ease,
      transform 300ms ease;
  }

  .car-captions li::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-inline-end: 0.625rem;
    border-radius: 50%;
    background: var(--taxi);
    vertical-align: middle;
  }

  .car-captions li[data-on] {
    opacity: 1;
    transform: none;
  }

  /* Phones and tablets: the headline is too wide to leave room beside it, so the facts appear
     under the car, where the scroll hint was (the hint is gone by the time the first fact shows). */
  @media (max-width: 1023px) {
    .car-area {
      --caption-room: 3rem;
    }

    .car-captions {
      inset-inline: 0;
      top: 100%;
      bottom: auto;
      margin: 0.75rem 0 0;
      text-align: center;
    }

    .car-captions li {
      inset-inline: 0;
      top: 0;
      bottom: auto;
      white-space: normal;
    }
  }

  .car-hint {
    display: none;
    position: absolute;
    inset-inline: 0;
    top: 100%;
    margin-top: 1.25rem;
    text-align: center;
    font-size: var(--fs-small);
    color: var(--text-muted);
    transition: opacity 400ms ease;
  }

  .car-viewer[data-scrub] .car-hint {
    display: block;
  }

  /* Very short screens: the car alone; the same facts are listed further down the page. */
  @container (max-height: 10rem) {
    .car-captions {
      display: none;
    }
  }

  .car-hint[data-hidden] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .car-hint,
    .car-captions li {
      transition: none;
    }
  }
</style>

<script>
  import { initCarViewer } from '../scripts/carViewer';

  document.querySelectorAll<HTMLElement>('[data-car-viewer]').forEach(initCarViewer);
</script>
