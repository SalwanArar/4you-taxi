---
// Scroll-driven car rotation (CLAUDE.md §6), used as the page hero. The car stands under one
// soft light; the slotted hero content sits above and below it, and short captions with car facts
// fade in at set points while it turns. Frame 1 is a normal <img>: it is the poster (and LCP image), the no-JS
// fallback and the reduced-motion view. The script swaps in a canvas once it runs.
interface Props {
  /** Path prefix of the frames, e.g. '/car360/frame_'. */
  frames: string;
  /** Number of frames. */
  count: number;
  extension: string;
  width: number;
  height: number;
  alt: string;
  /** Accessible name of the rotating canvas. */
  label: string;
  /** id of the heading inside the slot that names this section. */
  labelledBy: string;
  hint: string;
  /** Short facts shown one after another while the car turns (from site.ts). */
  captions?: string[];
  id?: string;
}

const {
  frames,
  count,
  extension,
  width,
  height,
  alt,
  label,
  labelledBy,
  hint,
  captions = [],
  id,
} = Astro.props;
const poster = `${frames}001${extension}`;
---

<section
  id={id}
  class="car-viewer"
  aria-labelledby={labelledBy}
  data-car-viewer
  data-frames={frames}
  data-extension={extension}
  data-count={count}
  data-width={width}
  data-height={height}
>
  <div class="car-sticky">
    <div class="car-stage" style={`--car-ratio: ${width} / ${height}`}>
      <div class="car-floor" aria-hidden="true"></div>
      <img
        src={poster}
        {width}
        {height}
        {alt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="car-frame"
      />
      <canvas class="car-frame car-canvas" role="img" aria-label={label}></canvas>
      <canvas class="car-reflection" data-reflection aria-hidden="true"></canvas>
      {captions.length > 0 && (
        <ul class="car-captions" aria-hidden="true">
          {captions.map((c) => (
            <li data-caption>{c}</li>
          ))}
        </ul>
      )}
      <p class="car-hint" data-hint aria-hidden="true">
        {hint}
      </p>
    </div>
    <slot />
  </div>
</section>

<style>
  /* Pure black, lit from above by one soft light. */
  /* Slides up under the translucent sticky header, so the first screen is the whole hero. */
  .car-viewer {
    position: relative;
    margin-top: calc(-1 * var(--header-h));
    background: var(--night);
  }

  /* One screen tall, laid out in three rows: hero text, the car, the call actions.
     Without JS or with reduced motion it simply stays one screen. */
  .car-sticky {
    position: sticky;
    top: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: 100vh;
    height: max(100svh, 36rem);
    overflow: hidden;
  }

  .car-sticky::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 55% at 50% 0%, var(--light-glow), transparent 70%);
    pointer-events: none;
  }

  /* Scrubbing mode, switched on by the script: tall section, the stage stays pinned. */
  .car-viewer[data-scrub] {
    height: 250vh;
  }

  @media (min-width: 640px) {
    .car-viewer[data-scrub] {
      height: 300vh;
    }
  }

  .car-stage {
    position: relative;
    grid-row: 2;
    align-self: center;
    margin-inline: auto;
    aspect-ratio: var(--car-ratio);
    width: min(100%, 920px, (100svh - 27rem) * var(--car-ratio));
    min-width: min(100%, 18rem);
  }

  .car-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .car-canvas {
    visibility: hidden;
  }

  .car-viewer[data-ready] .car-canvas {
    visibility: visible;
  }

  .car-viewer[data-ready] img.car-frame {
    visibility: hidden;
  }

  /* A faint mirror image of the car on the glossy ground, drawn and faded by the script.
     It sits half a stage lower so it has room below the wheels. */
  .car-reflection {
    position: absolute;
    inset-inline: 0;
    top: 50%;
    width: 100%;
    height: 100%;
    opacity: 0.13;
    pointer-events: none;
    visibility: hidden;
  }

  .car-viewer[data-ready] .car-reflection {
    visibility: visible;
  }

  /* The pool of light on the ground, with a soft shadow right under the car. */
  .car-floor {
    position: absolute;
    inset-inline: -12%;
    bottom: -10%;
    height: 34%;
    background:
      radial-gradient(38% 22% at 50% 50%, rgb(0 0 0 / 0.85), transparent 100%),
      radial-gradient(50% 50% at 50% 50%, var(--floor-glow), transparent 100%);
  }

  /* Car facts, one at a time, while it turns. */
  .car-captions {
    position: absolute;
    inset-inline-end: 1rem;
    bottom: 100%;
    margin: 0 0 0.5rem;
    padding: 0;
    list-style: none;
    font-size: var(--fs-lead);
  }

  .car-captions li {
    position: absolute;
    inset-inline-end: 0;
    bottom: 0;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity 300ms ease,
      transform 300ms ease;
  }

  .car-captions li::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-inline-end: 0.625rem;
    border-radius: 50%;
    background: var(--taxi);
    vertical-align: middle;
  }

  .car-captions li[data-on] {
    opacity: 1;
    transform: none;
  }

  .car-hint {
    display: none;
    position: absolute;
    inset-inline: 0;
    top: 100%;
    margin-top: 1.25rem;
    text-align: center;
    font-size: var(--fs-small);
    color: var(--text-muted);
    transition: opacity 400ms ease;
  }

  .car-viewer[data-scrub] .car-hint {
    display: block;
  }

  .car-hint[data-hidden] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .car-hint,
    .car-captions li {
      transition: none;
    }
  }
</style>

<script>
  import { initCarViewer } from '../scripts/carViewer';

  document.querySelectorAll<HTMLElement>('[data-car-viewer]').forEach(initCarViewer);
</script>
