---
// The page hero: the night story, told around the drawn taxi (CarDrawing.astro). The slotted hero
// content sits above and below the car. As the visitor scrolls, the script hands the progress
// through each scene to CSS (--t0 … --t4): the car drives in, drives on, then stops for you.
// Without JS or with reduced motion the section is one screen with the car standing still.
import CarDrawing from './CarDrawing.astro';

interface Props {
  /** Accessible name of the car drawing. */
  alt: string;
  /** id of the heading inside the slot that names this section. */
  labelledBy: string;
  hint: string;
  /**
   * The section plays as scenes. `edges` are where each scene starts (0 to 1 of the scroll); the
   * car is out of sight in the first two scenes and drives in at the third.
   */
  story: { edges: number[] };
  id?: string;
}

const { alt, labelledBy, hint, story, id } = Astro.props;
---

<section
  id={id}
  class="car-viewer"
  aria-labelledby={labelledBy}
  data-car-viewer
  data-story
  data-scene-edges={story.edges.join(',')}
>
  <div class="car-sticky">
    <div class="car-area">
      <div class="car-stage" data-scroll-vars>
        <div class="car-floor" aria-hidden="true"></div>
        <div class="car-road" aria-hidden="true"></div>
        <div class="car-drive">
          <CarDrawing label={alt} />
        </div>
        <p class="car-hint" data-hint aria-hidden="true">
          {hint}
        </p>
      </div>
    </div>
    <slot />
  </div>
</section>

<script is:inline>
  // Switch to the film before first paint, so the opening scene does not flash the end.
  (function () {
    const el = document.currentScript && document.currentScript.previousElementSibling;
    if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.dataset.scrub = 'true';
      el.dataset.scene = '0';
    }
  })();
</script>

<style>
  /* Pure black, lit from above by one soft light. */
  /* Slides up under the translucent sticky header, so the first screen is the whole hero. */
  .car-viewer {
    position: relative;
    margin-top: calc(-1 * var(--header-h));
    background: var(--night);
  }

  /* One screen tall, laid out in three rows: hero text, the car, the call actions.
     Without JS or with reduced motion it simply stays one screen. */
  .car-sticky {
    position: sticky;
    top: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: 100vh;
    height: max(100svh, 36rem);
    overflow: hidden;
  }

  .car-sticky::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 55% at 50% 0%, var(--light-glow), transparent 70%);
    pointer-events: none;
  }

  /* Story mode: a long section, so each of the first four scenes gets close to two screens of
     scroll and there is time to read every line. The last scene gets about 1.3 screens: enough to
     take in the call buttons, with a "more below" link so nobody mistakes it for the end. */
  .car-viewer[data-scrub][data-story] {
    height: 790vh;
  }

  @media (min-width: 640px) {
    .car-viewer[data-scrub][data-story] {
      height: 870vh;
    }
  }

  /* The night: the overhead light is low and the car is still in the dark. It comes up at the
     pickup (scene 2) and warms at the arrival (scene 4). */
  .car-viewer[data-scrub][data-story] .car-sticky::before {
    opacity: 0.25;
    transition: opacity 900ms ease;
  }

  .car-viewer[data-scrub][data-story]:is([data-scene='2'], [data-scene='3']) .car-sticky::before {
    opacity: 1;
  }

  .car-viewer[data-scrub][data-story] .car-sticky::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 60% at 50% 0%, rgb(255 194 14 / 0.1), transparent 70%);
    opacity: 0;
    transition: opacity 900ms ease;
    pointer-events: none;
  }

  .car-viewer[data-scrub][data-story][data-scene='4'] .car-sticky::before,
  .car-viewer[data-scrub][data-story][data-scene='4'] .car-sticky::after {
    opacity: 1;
  }

  /* The car stays in the dark during the first two scenes (drawn pictures tell those, see
     SceneArt.astro) and comes into the light at the pickup. */
  .car-viewer[data-scrub][data-story] .car-stage {
    opacity: 0;
    transform: scale(0.94);
    transition:
      opacity 1200ms ease,
      transform 1400ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .car-viewer[data-scrub][data-story]:is([data-scene='2'], [data-scene='3'], [data-scene='4'])
    .car-stage {
    opacity: 1;
    transform: none;
  }

  /* In story mode the hint sits in the middle of the dark stage, where the car will appear. */
  .car-viewer[data-story] .car-hint {
    top: 50%;
    margin-top: 0;
  }

  .car-viewer[data-scrub][data-story] .car-stage .car-hint {
    display: none;
  }

  /* The middle row: whatever height the hero text and call actions leave over. The car is sized
     from this height, so it never runs into the text above or the buttons below, in any language. */
  .car-area {
    --caption-room: 0rem; /* space kept free under the car for the facts (phones and tablets) */
    grid-row: 2;
    grid-column: 1;
    display: grid;
    align-content: center;
    min-height: 0;
    container-type: size;
  }

  .car-stage {
    --car-ratio: 1130 / 445;
    position: relative;
    margin-inline: auto;
    margin-bottom: var(--caption-room);
    aspect-ratio: var(--car-ratio);
    width: min(100%, 920px, (100svh - 27rem) * var(--car-ratio));
    width: min(100%, 920px, (100cqh - var(--caption-room)) * var(--car-ratio));
  }

  /* Phones and tablets: a little room under the car, so the facts below never touch it. */
  @media (max-width: 1023px) {
    .car-area {
      --caption-room: 3rem;
    }
  }

  /* The pool of light on the ground, with a soft shadow right under the car. */
  .car-floor {
    position: absolute;
    inset-inline: -12%;
    bottom: -10%;
    height: 34%;
    background:
      radial-gradient(38% 22% at 50% 50%, rgb(0 0 0 / 0.85), transparent 100%),
      radial-gradient(50% 50% at 50% 50%, var(--floor-glow), transparent 100%);
  }

  .car-hint {
    display: none;
    position: absolute;
    inset-inline: 0;
    top: 100%;
    margin-top: 1.25rem;
    text-align: center;
    font-size: var(--fs-small);
    color: var(--text-muted);
    transition: opacity 400ms ease;
  }

  .car-viewer[data-scrub] .car-hint {
    display: block;
  }

  /* The drawing's own box: its viewBox is 1130 x 445 (car plus headlight beam and reflection). */
  .car-drive {
    position: absolute;
    inset: 0;
  }

  .car-drive :global(.car-drawing) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Lane markings, drawn at the height of the wheels' contact with the road. */
  .car-road {
    position: absolute;
    inset-inline: -50vw;
    top: 82.5%;
    height: 3px;
    background: repeating-linear-gradient(90deg, #2a2925 0 56px, transparent 56px 120px);
    mask-image: linear-gradient(90deg, transparent, #000 35%, #000 65%, transparent);
  }

  /* Driving in (scene 2): the car rolls in from the right and eases to a stop at the centre.
     --t2 runs 0 to 1 through the scene; the car arrives at 70% of it. */
  .car-viewer[data-scrub] .car-stage {
    --arrive: clamp(0, var(--t2, 1) / 0.7, 1);
    --ease: calc(1 - (1 - var(--arrive)) * (1 - var(--arrive)));
  }

  .car-viewer[data-scrub] .car-drive {
    transform: translateX(calc((1 - var(--ease)) * (50vw + 60%)));
  }

  /* Wheels turn with the distance travelled: in while driving in (scene 2), then on the road
     (scene 3). The car faces left, so they turn anticlockwise. */
  .car-viewer[data-scrub] .car-drive :global(.spokes) {
    transform: rotate(calc((var(--ease) * -900 + var(--t3, 0) * -1500) * 1deg));
  }

  /* Driving on (scene 3): the lane markings slide past under the car. */
  .car-viewer[data-scrub] .car-road {
    background-position-x: calc(var(--t3, 0) * 1920px);
  }

  /* Stopping (scene 4): the brake lights come on. */
  .car-drive :global(.car-brake) {
    opacity: clamp(0, var(--t4, 1) * 5, 1);
  }

  .car-hint[data-hidden] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .car-hint {
      transition: none;
    }
  }
</style>

<script>
  import { initCarViewer } from '../scripts/carViewer';

  document.querySelectorAll<HTMLElement>('[data-car-viewer]').forEach(initCarViewer);
</script>
