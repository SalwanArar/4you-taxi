---
// Scroll-driven car rotation (CLAUDE.md §6), used as the page hero: the slotted content is
// overlaid on the car. Frame 1 is a normal <img>: it is the poster (and LCP image), the no-JS
// fallback and the reduced-motion view. The script swaps in a canvas once it runs.
interface Props {
  /** Path prefix of the frames, e.g. '/car360/frame_'. */
  frames: string;
  /** Number of frames. */
  count: number;
  extension: string;
  width: number;
  height: number;
  alt: string;
  /** Accessible name of the rotating canvas. */
  label: string;
  /** id of the heading inside the slot that names this section. */
  labelledBy: string;
  hint: string;
  id?: string;
}

const { frames, count, extension, width, height, alt, label, labelledBy, hint, id } = Astro.props;
const poster = `${frames}001${extension}`;
---

<section
  id={id}
  class="car-viewer"
  aria-labelledby={labelledBy}
  data-car-viewer
  data-frames={frames}
  data-extension={extension}
  data-count={count}
>
  <div class="car-sticky">
    <div class="car-stage" style={`--car-ratio: ${width} / ${height}`}>
      <div class="car-shadow" aria-hidden="true"></div>
      <img
        src={poster}
        {width}
        {height}
        {alt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="car-frame"
      />
      <canvas class="car-frame car-canvas" role="img" aria-label={label}></canvas>
    </div>
    <div class="car-scrim" aria-hidden="true"></div>
    <div class="car-overlay">
      <slot />
    </div>
    <p class="car-hint" data-hint aria-hidden="true">
      {hint}
    </p>
  </div>
</section>

<style>
  /* The hero is always dark (brand black), in both colour schemes: white text, white car. */
  .car-viewer {
    background: radial-gradient(ellipse at 50% 75%, #26282c 0%, var(--brand-black) 70%);
    color: #fff;
  }

  /* One screen tall. Without JS or with reduced motion it simply stays that way. */
  .car-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: max(100svh, 38rem);
    overflow: hidden;
  }

  /* Scrubbing mode, switched on by the script: tall section, the stage stays pinned. */
  .car-viewer[data-scrub] {
    height: 250vh;
  }

  @media (min-width: 640px) {
    .car-viewer[data-scrub] {
      height: 300vh;
    }
  }

  /* Car sits low and large; the text overlays its upper part. */
  .car-stage {
    position: absolute;
    inset-inline: 0;
    bottom: 3.5rem;
    margin-inline: auto;
    aspect-ratio: var(--car-ratio);
    width: min(100%, 1200px, calc((100svh - 8rem) * var(--car-ratio)));
  }

  .car-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .car-canvas {
    visibility: hidden;
  }

  .car-viewer[data-ready] .car-canvas {
    visibility: visible;
  }

  .car-viewer[data-ready] img.car-frame {
    visibility: hidden;
  }

  /* Soft ground shadow under the car. */
  .car-shadow {
    position: absolute;
    inset-inline: 12%;
    bottom: 2%;
    height: 10%;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.7);
    filter: blur(18px);
  }

  /* Darkens the top of the stage so the text stays readable where it crosses the car. */
  .car-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(11 11 12 / 0.92) 0%,
      rgb(11 11 12 / 0.75) 30%,
      rgb(11 11 12 / 0) 62%
    );
    pointer-events: none;
  }

  .car-overlay {
    position: relative;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: 6rem 1rem 0;
  }

  @media (min-width: 640px) {
    .car-overlay {
      padding-top: 7.5rem;
    }
  }

  .car-hint {
    display: none;
    position: absolute;
    inset-inline: 0;
    bottom: 1rem;
    text-align: center;
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.75);
    transition: opacity 400ms ease;
  }

  .car-viewer[data-scrub] .car-hint {
    display: block;
  }

  .car-hint[data-hidden] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .car-hint {
      transition: none;
    }
  }
</style>

<script>
  import { initCarViewer } from '../scripts/carViewer';

  document.querySelectorAll<HTMLElement>('[data-car-viewer]').forEach(initCarViewer);
</script>
