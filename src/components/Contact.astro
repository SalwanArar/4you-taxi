---
import Icon, { type IconName } from './Icon.astro';
import QrCode from './QrCode.astro';
import { business, content, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];

const actions: {
  icon: IconName;
  label: string;
  href: string;
  primary?: boolean;
  external?: boolean;
}[] = [
  { icon: 'phone', label: t.actions.call, href: `tel:${business.phone.e164}`, primary: true },
  {
    icon: 'whatsapp',
    label: t.actions.whatsapp,
    href: `https://wa.me/${business.whatsapp}`,
    external: true,
  },
  { icon: 'sms', label: t.actions.sms, href: `sms:${business.phone.e164}` },
  { icon: 'email', label: t.actions.email, href: `mailto:${business.email}` },
];

const details: { label: string; value: string; ltr?: boolean }[] = [
  { label: t.contact.emailLabel, value: business.email, ltr: true },
  { label: t.contact.areaLabel, value: t.serviceArea },
  { label: t.contact.availabilityLabel, value: t.availability },
];
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="section-grid">
    <div>
      <h2 id="contact-title" class="section-heading">
        {t.contact.heading}
      </h2>
      <p class="mt-3 text-muted">{t.contact.intro}</p>
    </div>
    <div>
      <p class="font-display" style="font-size: var(--fs-number); line-height: 1.1">
        <span class="sr-only">{t.contact.phoneLabel}: </span>
        <a
          href={`tel:${business.phone.e164}`}
          dir="ltr"
          class="inline-flex min-h-tap items-center tabular-nums no-underline hover:text-taxi"
        >
          {business.phone.display}
        </a>
      </p>

      <div class="mt-6 grid grid-cols-1 gap-3 min-[360px]:grid-cols-2 sm:flex sm:flex-wrap">
        {actions.map((a) => (
          <a
            href={a.href}
            class:list={['btn px-4 text-center text-lg', a.primary ? 'btn-call' : 'btn-ghost']}
            {...(a.external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            <Icon name={a.icon} />
            {a.label}
          </a>
        ))}
      </div>

      <div class="mt-10 flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
        <dl class="rows flex-1">
          {details.map((d) => (
            <div class="flex flex-wrap justify-between gap-x-6 gap-y-1">
              <dt class="text-muted">{d.label}</dt>
              <dd class="break-all" dir={d.ltr ? 'ltr' : undefined}>
                {d.value}
              </dd>
            </div>
          ))}
        </dl>
        {/* Hidden on phones: the visitor is already on the phone that would scan it. */}
        <div class="hidden sm:block">
          <QrCode value={`tel:${business.phone.e164}`} label={t.contact.qrLabel} />
        </div>
      </div>
    </div>
  </div>
</section>
