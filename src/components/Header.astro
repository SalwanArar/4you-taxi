---
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { business, content, type Locale } from '../data/site';
import { withBase } from '../utils/withBase';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
---

<header class="sticky top-0 z-40 border-b border-line/60 bg-night/80 backdrop-blur-md">
  <div class="wrap flex items-center justify-between gap-2 py-2">
    <a href="#top" class="inline-flex min-h-tap shrink-0 items-center rounded-box">
      <img
        src={withBase('/logo.webp')}
        alt={business.name}
        width="68"
        height="40"
        class="h-10 w-auto"
      />
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      <LanguageSwitcher locale={locale} />
      <a href={`tel:${business.phone.e164}`} class="btn btn-ghost px-4">
        <Icon name="phone" size={18} />
        {t.actions.callShort}
      </a>
    </div>
  </div>
</header>
