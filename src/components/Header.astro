---
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { business, content, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
---

<header class="sticky top-0 z-40 border-b border-border bg-surface/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-content items-center justify-between gap-2 px-4 py-2">
    <a href="#top" class="inline-flex min-h-tap items-center text-lg font-bold whitespace-nowrap">
      {business.name}
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      <LanguageSwitcher locale={locale} />
      <a href={`tel:${business.phone.e164}`} class="btn btn-primary px-4">
        <Icon name="phone" size={18} />
        {t.actions.callShort}
      </a>
    </div>
  </div>
</header>
