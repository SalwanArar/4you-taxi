---
// A clear language button: globe, the current language, and a menu listing every language in its
// own script. Testers missed the old row of small links. No flags: they stand for countries, not
// languages. Works without JS (<details>); the script only closes it on outside click or Escape.
import { getRelativeLocaleUrl } from 'astro:i18n';
import Icon from './Icon.astro';
import { content, localeInfo, locales, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<nav class="lang" aria-label={content[locale].languageSwitcherLabel}>
  <details data-lang-menu>
    <summary class="btn btn-ghost lang-button">
      <Icon name="globe" size={18} />
      <span>{localeInfo[locale].label}</span>
      <Icon name="chevron-down" size={16} class="lang-chevron" />
    </summary>
    <ul class="lang-list">
      {locales.map((l) => (
        <li>
          <a
            href={getRelativeLocaleUrl(l)}
            lang={l}
            hreflang={l}
            dir={localeInfo[l].dir}
            aria-current={l === locale ? 'page' : undefined}
          >
            <span>{localeInfo[l].label}</span>
            {l === locale && <Icon name="check" size={16} />}
          </a>
        </li>
      ))}
    </ul>
  </details>
</nav>

<script>
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-lang-menu]')) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .lang {
    position: relative;
  }

  .lang-button {
    gap: 0.5rem;
    padding-inline: 0.875rem;
    list-style: none;
    cursor: pointer;
  }

  .lang-button::-webkit-details-marker {
    display: none;
  }

  .lang-button :global(.lang-chevron) {
    color: var(--text-muted);
    transition: transform 200ms ease;
  }

  details[open] .lang-button :global(.lang-chevron) {
    transform: rotate(180deg);
  }

  .lang-list {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.5rem);
    z-index: 50;
    min-width: 11rem;
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    background: var(--asphalt);
    border: 1px solid var(--line);
    border-radius: var(--radius-box);
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 0.6);
  }

  .lang-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--tap-min);
    padding-inline: 0.875rem;
    border-radius: calc(var(--radius-box) - 4px);
    color: var(--text-muted);
    font-weight: 500;
    text-decoration: none;
  }

  .lang-list a:hover,
  .lang-list a:focus-visible {
    background: var(--line);
    color: var(--text);
  }

  .lang-list a[aria-current='page'] {
    color: var(--text);
  }

  .lang-list a[aria-current='page'] :global(svg) {
    color: var(--taxi);
  }

  /* The smallest phones: the globe alone, the language name stays for screen readers. */
  @media (max-width: 359px) {
    .lang-button > span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
