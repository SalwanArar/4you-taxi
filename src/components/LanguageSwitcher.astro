---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { content, localeInfo, locales, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<nav aria-label={content[locale].languageSwitcherLabel}>
  <ul class="flex">
    {locales.map((l) => (
      <li>
        <a
          href={getRelativeLocaleUrl(l)}
          lang={l}
          hreflang={l}
          aria-current={l === locale ? 'page' : undefined}
          class="inline-flex min-h-tap min-w-tap items-center justify-center rounded-brand px-2 text-sm font-medium text-white/70 hover:text-white aria-[current=page]:font-bold aria-[current=page]:text-white sm:px-3"
        >
          <span class="sm:hidden" aria-hidden="true">
            {localeInfo[l].short}
          </span>
          <span class="sr-only sm:not-sr-only">{localeInfo[l].label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
