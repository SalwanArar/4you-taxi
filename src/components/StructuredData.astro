---
// JSON-LD for search engines (CLAUDE.md §7). Real data only. Hours (owner, 2026-11-22): Monday to Friday
// at any time; Saturday and Sunday by booking only, so the weekend is not listed as open.
import { business, localeInfo, locales } from '../data/site';

const data = {
  '@context': 'https://schema.org',
  '@type': 'TaxiService',
  name: business.name,
  telephone: business.phone.e164,
  ...(business.email ? { email: business.email } : {}),
  ...(business.googleBusiness ? { sameAs: [business.googleBusiness] } : {}),
  areaServed: {
    '@type': 'AdministrativeArea',
    name: business.region,
    address: {
      '@type': 'PostalAddress',
      addressRegion: business.region,
      addressCountry: business.country,
    },
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '00:00',
    closes: '23:59',
  },
  availableLanguage: locales.map((l) => ({
    '@type': 'Language',
    name: localeInfo[l].label,
    alternateName: l,
  })),
  ...(Astro.site ? { url: new URL(Astro.url.pathname, Astro.site).href } : {}),
};
---

<script type="application/ld+json" set:html={JSON.stringify(data)} is:inline />
