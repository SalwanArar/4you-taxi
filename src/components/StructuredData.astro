---
// JSON-LD for search engines (CLAUDE.md §7). Real data only: no opening hours, the service is on call.
import {
  business,
  company,
  content,
  defaultLocale,
  isPlaceholder,
  localeInfo,
  locales,
  paymentMethods,
} from '../data/site';

// Only real values are published: placeholders and empty values are left out.
const real = (value: string) => (value && !isPlaceholder(value) ? value : undefined);
const methods = paymentMethods.map((m) => content[defaultLocale].prices.methods[m]);

const data = {
  '@context': 'https://schema.org',
  '@type': 'TaxiService',
  name: business.name,
  telephone: business.phone.e164,
  ...(business.email ? { email: business.email } : {}),
  ...(real(company.legalName) ? { legalName: company.legalName } : {}),
  ...(real(company.orgNumber) ? { taxID: company.orgNumber } : {}),
  ...(methods.length ? { paymentAccepted: methods.join(', ') } : {}),
  areaServed: {
    '@type': 'AdministrativeArea',
    name: business.region,
    address: {
      '@type': 'PostalAddress',
      addressRegion: business.region,
      addressCountry: business.country,
    },
  },
  availableLanguage: locales.map((l) => ({
    '@type': 'Language',
    name: localeInfo[l].label,
    alternateName: l,
  })),
  ...(Astro.site ? { url: new URL(Astro.url.pathname, Astro.site).href } : {}),
};
---

<script type="application/ld+json" set:html={JSON.stringify(data)} is:inline />
