---
// About the company: one large line, then the languages spoken. No person is named.
import { content, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
---

<section class="section section-screen" aria-labelledby="about-title">
  <div class="wrap">
    <h2 id="about-title" class="statement" data-reveal>
      {t.about.heading}
    </h2>
    {t.about.bio && (
      <p class="bio mt-10 font-display" data-reveal style="--i: 1">
        {t.about.bio}
      </p>
    )}
    <p class="mt-10 border-t border-line pt-5 text-muted" data-reveal style="--i: 2">
      {t.about.languagesLabel}: {t.about.languagesSpoken}
    </p>
  </div>
</section>

<style>
  .bio {
    max-width: 30ch;
    margin-inline-start: auto;
    font-size: var(--fs-heading);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  :global(:lang(ar)) .bio {
    line-height: 1.6;
    letter-spacing: 0;
  }
</style>
