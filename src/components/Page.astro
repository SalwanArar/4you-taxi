---
import Base from '../layouts/Base.astro';
import CarDetails from './CarDetails.astro';
import CarViewer from './CarViewer.astro';
import Contact from './Contact.astro';
import Driver from './Driver.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import SceneArt from './SceneArt.astro';
import Hero from './Hero.astro';
import StickyCallBar from './StickyCallBar.astro';
import { carFrames, content, type Locale } from '../data/site';
import { withBase } from '../utils/withBase';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
// Where each of the five story scenes starts, as a share of the opening's scroll. The car turns
// from the pickup (scene 2) to the arrival (scene 4).
const storyEdges = [0, 0.133, 0.288, 0.487, 0.818];
---

<Base locale={locale}>
  <a
    href="#main"
    class="sr-only z-50 rounded-brand bg-taxi px-4 py-3 font-semibold text-on-taxi focus:not-sr-only focus:fixed focus:start-4 focus:top-4"
  >
    {t.skipLink}
  </a>
  <Header locale={locale} />
  <main id="main">
    <CarViewer
      id="top"
      frames={withBase(carFrames.basePath)}
      count={carFrames.count}
      extension={carFrames.extension}
      width={carFrames.width}
      height={carFrames.height}
      alt={t.car.alt}
      label={t.car.rotatingLabel}
      labelledBy="hero-title"
      hint={t.car.scrollHint}
      story={{ edges: storyEdges, turnStart: storyEdges[2], turnEnd: storyEdges[4] }}
    >
      <Hero locale={locale} storyEdges={storyEdges} />
      <SceneArt />
    </CarViewer>
    <CarDetails locale={locale} />
    <Driver locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
  <StickyCallBar locale={locale} />
</Base>

<script>
  // Let each [data-reveal] element rise into view the first time it is reached (see global.css).
  if ('IntersectionObserver' in window) {
    document.documentElement.toggleAttribute('data-reveal-on', true);
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.toggleAttribute('data-shown', true);
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
  }
</script>
