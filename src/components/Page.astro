---
import Base from '../layouts/Base.astro';
import CarDetails from './CarDetails.astro';
import CarViewer from './CarViewer.astro';
import Contact from './Contact.astro';
import Driver from './Driver.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import StickyCallBar from './StickyCallBar.astro';
import { carFrames, content, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];

// Prefix public/ paths with the base path (e.g. /4you-taxi on GitHub Pages).
const withBase = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}${path}`;
---

<Base locale={locale}>
  <a
    href="#main"
    class="sr-only z-50 rounded-brand bg-brand-yellow px-4 py-3 font-semibold text-on-yellow focus:not-sr-only focus:fixed focus:start-4 focus:top-4"
  >
    {t.skipLink}
  </a>
  <Header locale={locale} />
  <main id="main">
    <CarViewer
      id="top"
      frames={withBase(carFrames.basePath)}
      count={carFrames.count}
      extension={carFrames.extension}
      width={carFrames.width}
      height={carFrames.height}
      alt={t.car.alt}
      label={t.car.rotatingLabel}
      labelledBy="hero-title"
      hint={t.car.scrollHint}
    >
      <Hero locale={locale} />
    </CarViewer>
    <CarDetails locale={locale} />
    <Driver locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
  <StickyCallBar locale={locale} />
</Base>
