---
import '@fontsource-variable/familjen-grotesk/wght.css';
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '../styles/global.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import StructuredData from '../components/StructuredData.astro';
import { business, content, defaultLocale, localeInfo, locales, type Locale } from '../data/site';
import { withBase } from '../utils/withBase';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { meta } = content[locale];
const { dir } = localeInfo[locale];
// Canonical and hreflang need absolute URLs, so they wait until `site` is set in astro.config.mjs.
const hasSite = Astro.site !== undefined;
const ogImage = hasSite ? new URL(withBase('/og-image.jpg'), Astro.site).href : undefined;
const ogLocale: Record<Locale, string> = { sv: 'sv_SE', en: 'en_GB', ar: 'ar_AR' };
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content="#000000" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <StructuredData />
    {hasSite && (
      <>
        <link rel="canonical" href={getAbsoluteLocaleUrl(locale)} />
        <meta property="og:url" content={getAbsoluteLocaleUrl(locale)} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={content[locale].car.alt} />
        <meta name="twitter:card" content="summary_large_image" />
        {locales.map((l) => (
          <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLocale)} />
      </>
    )}
  </head>
  <body class="pb-24 sm:pb-0">
    <slot />
  </body>
</html>
